# Database
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# AWS S3
AWS_S3_BUCKET_NAME=your-s3-bucket
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Selenium Grid (web scraping) - set SELENIUM_PROCESSING=true to enable
SELENIUM_PROCESSING=false
SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub
# Parallelism = MAX_SELENIUM_GRID_NODES x SE_NODE_MAX_SESSIONS
MAX_SELENIUM_GRID_NODES=5
SE_NODE_MAX_SESSIONS=3
SE_NODE_OVERRIDE_MAX_SESSIONS=true
SELENIUM_NODE_SHM_SIZE=2g
SELENIUM_AUTO_MANAGE_NODES=true
SELENIUM_NETWORK=selenium-grid
SELENIUM_HUB_CONTAINER=selenium-hub
SELENIUM_NODE_IMAGE=selenium/node-chrome:latest
SELENIUM_NODE_STARTUP_TIMEOUT=120

# Kerala Registration Date / Fuel scraper
# Single .xlsx workbook or a folder containing .xlsx workbooks
REG_DATE_FUEL_EXCEL_PATH=C:\path\to\workbook_or_folder
