# Database
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# AWS S3
AWS_S3_BUCKET_NAME=your-s3-bucket
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ---------------------------------------------------------------------------
# Selenium mode (same program supports both; change these between runs)
#   SELENIUM_MODE=local  -> one local Chrome browser
#   SELENIUM_MODE=grid   -> Selenium Grid at SELENIUM_REMOTE_URL
# ---------------------------------------------------------------------------
SELENIUM_MODE=local

# Hub WebDriver endpoint (not the /ui/ page)
# Local Docker hub:  http://localhost:4444/wd/hub
# LAN hosted hub:    http://192.168.1.200:4444/wd/hub
SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub

# How many parallel Chrome sessions the scraper opens on Grid
# For uneven remote nodes (e.g. 10+10+50), set this to the total slots: 70
SELENIUM_MAX_PARALLEL_SESSIONS=70

# Used when SELENIUM_AUTO_MANAGE_NODES=true (this machine starts Docker nodes)
MAX_SELENIUM_GRID_NODES=3
SE_NODE_MAX_SESSIONS=10
SE_NODE_OVERRIDE_MAX_SESSIONS=true
SELENIUM_NODE_SHM_SIZE=2g

# true  = start/stop Chrome node containers from this PC (local Docker Grid)
# false = use an already-running hub/nodes (e.g. http://192.168.1.200:4444)
SELENIUM_AUTO_MANAGE_NODES=false

SELENIUM_NETWORK=selenium-grid
SELENIUM_HUB_CONTAINER=selenium-hub
SELENIUM_NODE_IMAGE=selenium/node-chrome:latest
SELENIUM_NODE_STARTUP_TIMEOUT=120

# Kerala Registration Date / Fuel scraper
# Single .xlsx workbook or a folder containing .xlsx workbooks
REG_DATE_FUEL_EXCEL_PATH=C:\path\to\workbook_or_folder
